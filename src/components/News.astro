---
interface Props {
  title: string
  excerpt: string
  featuredImage: string
  date: string
  slug: string
}

const { title, excerpt, featuredImage, date, slug } = Astro.props

const fecha = new Date(date)
const fechaCL = fecha.toLocaleDateString("es-CL", {
  day: "2-digit",
  month: "long",
  year: "numeric",
})
---

<article
  class="group rounded-xl overflow-hidden border border-zinc-200/70 bg-white shadow-sm hover:shadow-md transition-shadow"
>
  <a href={`/noticias/${slug}/`} class="block">
    <img
      src={featuredImage}
      alt={title}
      loading="lazy"
      decoding="async"
      class="w-full aspect-[16/9] object-cover"
    />
  </a>

  <div class="p-4">
    <time
      datetime={fecha.toISOString()}
      class="text-xs uppercase tracking-wide text-zinc-500"
    >
      {fechaCL}
    </time>

    <a href={`/noticias/${slug}/`} class="mt-1 block">
      <h3
        class="text-lg font-semibold leading-snug text-zinc-900 group-hover:text-blue-700 transition-colors"
      >
        {title}
      </h3>
    </a>

    <p class="mt-2 text-sm text-zinc-700 line-clamp-3">
      {excerpt}
    </p>

    <div class="mt-4">
      <a
        href={`/noticias/${slug}/`}
        class="inline-flex items-center gap-2 text-sm font-medium text-blue-700 hover:text-blue-800"
        aria-label={`Leer noticia: ${title}`}
      >
        Leer más
        <svg viewBox="0 0 24 24" class="size-4"
          ><path
            fill="currentColor"
            d="M13.172 12L8.222 7.05l1.414-1.414L16 12l-6.364 6.364-1.414-1.414z"
          ></path></svg
        >
      </a>
    </div>
  </div>
</article>
